{
  "name": "gameforge-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts --production",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "local": "node --env-file-if-exists=.env scripts/local.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.18",
    "jszip": "^3.10.1",
    "lucide-react": "^1.77.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
