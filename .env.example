# Cloud & Local configuration for GameForge AI
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Server-side Gemini API key (supports both AIza and AQ. key formats)
# Can be provided via GEMINI_API_KEY or MY_CUSTOM_GEMINI_KEY in AI Studio Secrets
GEMINI_API_KEY=
MY_CUSTOM_GEMINI_KEY=

# Active free-tier eligible models (@google/genai)
GEMINI_ELITE_MODEL=gemini-4-hydrogen
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# Optional pacing between live Gemini calls (ms) to prevent 429 rate-limit spikes
GEMINI_MIN_DELAY_MS=2500

# Set to 1 only if the user explicitly enabled a paid API key for generative image models
GEMINI_PAID_KEY_APPROVED=0

# Optional local Mac/PC workstation engines (loopback only)
ENGINES_DIR=../../work/engines
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
COMFY_URL=http://127.0.0.1:8188
COMFY_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
SEARXNG_URL=http://127.0.0.1:8888
WIKI_USER_AGENT="GameForgeAI/0.2 (quiz studio)"
