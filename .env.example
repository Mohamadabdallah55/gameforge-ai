# Local tools work without an API key. Elite question production requires Gemini.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Relative to the repository root. The launcher uses only loopback interfaces.
ENGINES_DIR=../../work/engines
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
# Local vision assists in Media Lab and standalone image batches.
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
COMFY_URL=http://127.0.0.1:8188
COMFY_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
SEARXNG_URL=http://127.0.0.1:8888
WIKI_USER_AGENT="GameForgeAI/0.2 (local quiz editor)"
# Elite production requires a Gemini API key from a project with no Cloud Billing.
# Set =1 only after confirming Free Tier in the selected API project.
GEMINI_FREE_PROJECT_CONFIRMED=0
GEMINI_ELITE_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
